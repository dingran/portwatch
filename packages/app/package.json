{
  "name": "@portwatch/app",
  "version": "1.1.0",
  "description": "PortWatch menu bar app",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "postinstall": "chmod +x ../../node_modules/7zip-bin/mac/*/7za || true",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "npm run build && playwright test",
    "test:headed": "npm run build && playwright test --headed",
    "test:debug": "npm run build && playwright test --debug",
    "test:ui": "npm run build && playwright test --ui",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "port",
    "monitoring",
    "electron",
    "menubar"
  ],
  "author": "dingran",
  "license": "MIT",
  "dependencies": {
    "@portwatch/core": "^1.0.0",
    "electron-store": "^8.1.0",
    "menubar": "^9.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.1.4",
    "electron-builder": "^24.9.1",
    "electron-vite": "^4.0.1",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.portwatch.app",
    "productName": "PortWatch",
    "electronVersion": "28.3.3",
    "compression": "store",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "assets/icon.icns"
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    }
  }
}
